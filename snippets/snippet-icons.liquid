{%- comment -%}
  Usage:
      {%- render 'snippet-icons', name: 'search', width: '100px', height: '100px'  -%}

  Summary:
      Componentized SVG icon handling.

  When adding SVGs:
      - Use SVGOMG to optimize SVGs, as needed: https://jakearchibald.github.io/svgomg/
      - In most cases, populate 'fill' attributes with 'currentColor'
          (Usually not in parent tag, in which fill="none" is automatically included)
      - Include aria-labelledby & <title> for accessibility
      - width="100%" included for proper SVG display in Safari
      - Refer to 'example' below for optimal structure:

  Example:
      {%- when 'example' -%}
          <svg aria-labelledby="{{ icon_id }}" class="{{ icon_classes }}" viewbox="0 0 100 100">
              <title id="{{ icon_id }}">{{ name | capitalize }} Icon</title>
              <path fill="currentColor"></path>
          </svg>
{%- endcomment -%}

{%- liquid
  assign icon_id = name | append: '-id'
  assign icon_classes = 'snippet-icon snippet-icon-' | append: name | append: ' ' | append: classes
  if width
    assign icon_width = ' width="' | append: width | append: '"'
  else
    assign icon_width = ' width="100%"'
  endif
  if height
    assign icon_height = ' height="' | append: height | append: '"'
  else
    assign icon_height = ' height="auto"'
  endif
  assign icon_props = 'fill="none" aria-labelledby="' | append: icon_id | append: '" class="' | append: icon_classes | append: '"' | append: icon_width | append: icon_height
-%}

